modules = ["python-3.12", "web", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 tools/serve-site.py --port 5000 --bind 0.0.0.0 --directory dist"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80
